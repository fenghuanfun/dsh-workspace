{
  "name": "dsh-workspace",
  "version": "1.0.0",
  "description": "Add or remove extra source directories for a DSH workspace, beside its own directory.",
  "license": "MIT",
  "author": "fenghuanfun",
  "homepage": "https://github.com/fenghuanfun/dsh-workspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenghuanfun/dsh-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/fenghuanfun/dsh-workspace/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/host.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
